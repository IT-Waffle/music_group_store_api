# Production Nginx example for amorfati.lv (Cloudflare -> Nginx -> API).
# Adjust the upstream (api:8000 inside Docker, 127.0.0.1:8000 on the host)
# and filesystem paths.

# ---- http {} context -------------------------------------------------------
# Real client IP from Cloudflare. Without this every visitor looks like a
# Cloudflare edge address and per-IP limits (login, comments) are shared by
# everybody. Keep the list in sync with https://www.cloudflare.com/ips/
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;
real_ip_header CF-Connecting-IP;

# Optional flood protection (availability only; views stay non-unique).
# limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=20r/s;

# ---- server {} context (HTTPS server block) --------------------------------

# Small default body; only upload routes below allow big files.
client_max_body_size 1m;

location /api/ {
    # limit_req zone=api_per_ip burst=40 nodelay;
    proxy_pass http://api:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Overwrite (do not append) so a client cannot spoof its address.
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Admin uploads: large bodies, streamed to the API without disk buffering.
# The API itself rejects anonymous uploads before reading the body.
location ~ ^/api/v1/(catalog/products/[^/]+/images|music/manage/(tracks/[^/]+/(audio|cover)|clips/[^/]+/(video|poster)))/?$ {
    client_max_body_size 520m;
    proxy_request_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    proxy_pass http://api:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Liveness is fine to expose; readiness only from the server itself.
location = /health/live {
    proxy_pass http://api:8000;
}
location = /health/ready {
    allow 127.0.0.1;
    deny all;
    proxy_pass http://api:8000;
}

# The application returns X-Accel-Redirect to this location only after checking
# track/clip publication or admin authorization. It must never be public.
location /_protected_music_media/ {
    internal;
    alias /srv/amor-fati/music/;
    add_header Accept-Ranges bytes always;
    add_header X-Content-Type-Options nosniff always;
}

# Product images are public files; never let the browser sniff them as HTML.
location /uploads/products/ {
    proxy_pass http://api:8000;
    add_header X-Content-Type-Options nosniff always;
}

# ---- uvicorn (API container) -------------------------------------------------
# uvicorn trusts X-Forwarded-For only from FORWARDED_ALLOW_IPS (default
# 127.0.0.1). Set it in .env to the Nginx address, e.g. the Docker network
# subnet: FORWARDED_ALLOW_IPS=172.18.0.0/16. Never "*" while port 8000 is
# reachable from the internet.
